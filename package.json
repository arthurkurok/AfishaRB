{
  "name": "afisha-rb",
  "private": true,
  "description": "Тамаша · Афиша культуры Башкортостана — монорепозиторий",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "pnpm -r --if-present run typecheck && biome check . && pnpm -r --if-present run test && pnpm --filter @afisha/api run depcruise",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "build:web": "pnpm --filter @afisha/widget build && pnpm --filter @afisha/web build",
    "e2e": "pnpm --filter @afisha/web e2e",
    "build:admin": "pnpm --filter @afisha/admin build",
    "e2e:admin": "pnpm --filter @afisha/admin e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "typescript": "~5.9.3"
  }
}
