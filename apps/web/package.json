{
  "name": "@afisha/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Публичный сайт, Telegram Mini App (/tma) и iframe-фоллбэк виджета (/embed)",
  "scripts": {
    "prepare-assets": "node scripts/prepare-assets.mjs",
    "dev": "node scripts/prepare-assets.mjs && next dev -p 3000",
    "build": "node scripts/prepare-assets.mjs && next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "screenshots": "playwright test --project=screens"
  },
  "dependencies": {
    "@afisha/design-tokens": "workspace:*",
    "@afisha/i18n": "workspace:*",
    "next": "16.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@afisha/contract": "workspace:*",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  }
}
