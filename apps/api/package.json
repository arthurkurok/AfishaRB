{
  "name": "@afisha/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Бэкенд: Public API, BFF, админ-API, Telegram-бот, воркеры, ИИ-гид",
  "scripts": {
    "dev": "tsx watch src/main/api.ts",
    "build": "node scripts/build.mjs",
    "start:prod": "node dist/api.js",
    "bot:prod": "node dist/bot.js",
    "worker:prod": "node dist/worker.js",
    "start": "tsx src/main/api.ts",
    "bot": "tsx src/main/bot.ts",
    "worker": "tsx src/main/worker.ts",
    "cli": "tsx src/main/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate && node scripts/fix-migrations.mjs",
    "db:migrate": "tsx src/main/cli.ts db:migrate",
    "openapi": "tsx src/main/cli.ts openapi:export",
    "depcruise": "node scripts/depcruise.mjs"
  },
  "dependencies": {
    "@afisha/contract": "workspace:*",
    "@fastify/cors": "^11.4.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/swagger": "^9.9.3",
    "@grammyjs/runner": "^2.0.3",
    "@scalar/fastify-api-reference": "^1.76.4",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "fastify-type-provider-zod": "^7.0.0",
    "fuzzball": "^2.2.6",
    "grammy": "^1.46.0",
    "https-proxy-agent": "^9.1.0",
    "openai": "^7.47.0",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.0",
    "pino": "^10.4.0",
    "redis": "^6.3.1",
    "sanitize-html": "^2.18.1",
    "socks-proxy-agent": "^10.1.0",
    "undici": "^8.12.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/sanitize-html": "^2.16.2",
    "dependency-cruiser": "^18.7.1",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
