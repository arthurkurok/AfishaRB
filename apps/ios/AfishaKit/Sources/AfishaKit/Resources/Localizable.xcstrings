        "ba": {
          "stringUnit": {
            "state": "translated",
            "value": "Гид ябайлаштырылған режимда эшләй — яһалма интеллектһыҙ, ҡағиҙәләр буйынса. Саралар шул уҡ, тикшерелгән афишанан, әммә ҡатмарлы һорауҙарҙы насарыраҡ аңлай."
          }
