    "guide.rules_mode": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Гид работает в упрощённом режиме — без ИИ, по правилам. События те же, из проверенной афиши, но сложные запросы он понимает хуже."
          }
