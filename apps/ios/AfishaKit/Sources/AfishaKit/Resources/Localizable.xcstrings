    "rules.1.text": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подборки, Гид и сортировка «Подходящие» показывают только реальные события из проверенной афиши. Места в выдаче не продаются."
          }
        },
        "ba": {
          "stringUnit": {
            "state": "translated",
            "value": "Һайлауҙар, Гид һәм «Тап килгәндәр» тәртибе тикшерелгән афишаның ысын сараларын ғына күрһәтә. Һөҙөмтәләрҙәге урындар һатылмай."
          }
        }
      }
    },
    "rules.1.title": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что мы рекомендуем"
          }
        },
        "ba": {
          "stringUnit": {
            "state": "translated",
            "value": "Беҙ нимә тәҡдим итәбеҙ"
          }
        }
      }
    },
    "rules.2.text": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только то, что вы указали в запросе и фильтрах: дата, город, возраст ребёнка, бюджет, категории; геопозиция — если вы её разрешили. История просмотров для рекомендаций не используется."
          }
        },
        "ba": {
          "stringUnit": {
            "state": "translated",
            "value": "Һеҙ һорауҙа һәм фильтрҙарҙа күрһәткән мәғлүмәт кенә: көн, ҡала, баланың йәше, бюджет, категориялар; урын — әгәр рөхсәт итһәгеҙ. Ҡарауҙар тарихы тәҡдимдәр өсөн ҡулланылмай."
          }
        }
      }
    },
    "rules.2.title": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Какие сведения используются"
          }
        },
        "ba": {
          "stringUnit": {
            "state": "translated",
            "value": "Ниндәй мәғлүмәттәр ҡулланыла"
          }
        }
      }
    },
    "rules.3.text": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Учитываются совпадение с запросом, время начала, расстояние, цена, возрастной знак и полнота данных события. Под каждой карточкой Гида — причины, почему она в подборке."
          }
        },
        "ba": {
          "stringUnit": {
            "state": "translated",
            "value": "Һорауға тура килеү, башланыу ваҡыты, алыҫлыҡ, хаҡ, йәш билдәһе һәм сара мәғлүмәттәренең тулылығы иҫәпкә алына. Гидтың һәр карточкаһы аҫтында — ни өсөн һайлауға эләгеүенең сәбәптәре."
          }
        }
      }
    },
    "rules.3.title": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как работает ранжирование"
          }
        },
        "ba": {
          "stringUnit": {
            "state": "translated",
            "value": "Тәртипкә һалыу нисек эшләй"
          }
        }
      }
    },
    "rules.4.text": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "PRO.Культура.РФ, сайты учреждений культуры и кабинет учреждения. У каждого события есть паспорт с источниками и историей изменений."
          }
        },
        "ba": {
          "stringUnit": {
            "state": "translated",
            "value": "PRO.Культура.РФ, мәҙәниәт учреждениелары сайттары һәм учреждение кабинеты. Һәр сараның сығанаҡтары һәм үҙгәрештәр тарихы булған паспорты бар."
          }
        }
      }
    },
    "rules.4.title": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Источники данных"
          }
        },
        "ba": {
          "stringUnit": {
            "state": "translated",
            "value": "Мәғлүмәт сығанаҡтары"
          }
        }
      }
    },
    "rules.5.text": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Владелец сервиса и контакты для вопросов о рекомендациях указаны на странице правил на сайте."
          }
        },
        "ba": {
          "stringUnit": {
            "state": "translated",
