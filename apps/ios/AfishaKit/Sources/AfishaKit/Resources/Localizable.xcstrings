{
  "sourceLanguage": "ru",
  "strings": {
    "about.fonts": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Шрифты Golos Text и Commissioner — лицензия SIL Open Font License 1.1."
          }
        },
        "ba": {
          "stringUnit": {
            "state": "translated",
            "value": "Golos Text һәм Commissioner шрифттары — SIL Open Font License 1.1 лицензияһы."
          }
        }
      }
    },
    "about.sources": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные — из PRO.Культура.РФ, сайтов учреждений и кабинета учреждения. У каждого события видно источник и время проверки."
          }
        },
        "ba": {
          "stringUnit": {
            "state": "translated",
            "value": "Мәғлүмәттәр — PRO.Культура.РФ, учреждение сайттарынан һәм учреждение кабинетынан. Һәр сараның сығанағы һәм тикшереү ваҡыты күренә."
          }
        }
      }
    },
    "about.text": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Тамаша» — единая достоверная афиша культурных событий Республики Башкортостан: театры, концерты, музеи, праздники и лекции во всех городах и районах."
          }
        },
        "ba": {
          "stringUnit": {
            "state": "translated",
            "value": "«Тамаша» — Башҡортостан Республикаһы мәҙәни сараларының берҙәм ышаныслы афишаһы: бөтә ҡалаларҙа һәм райондарҙа театрҙар, концерттар, музейҙар, байрамдар һәм лекциялар."
          }
        }
      }
    },
    "about.translation": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевод интерфейса на башкирский язык выполнен командой проекта. Заметили неточность — напишите нам, правки принимаются."
          }
        },
        "ba": {
          "stringUnit": {
            "state": "translated",
            "value": "Интерфейсты башҡорт теленә тәржемәне проект командаһы башҡарҙы. Хата күрһәгеҙ — яҙығыҙ, төҙәтмәләр ҡабул ителә."
          }
        }
      }
    },
    "about.translation.suggest": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предложить правку перевода"
          }
        },
        "ba": {
          "stringUnit": {
            "state": "translated",
            "value": "Тәржемәгә төҙәтмә тәҡдим итеү"
          }
        }
      }
    },
