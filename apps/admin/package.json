{
  "name": "@afisha/admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Веб-интерфейс для сотрудников: кабинет учреждения, модерация и дашборд министерства «Пульс культуры»",
  "scripts": {
    "prepare-assets": "node scripts/prepare-assets.mjs",
    "dev": "node scripts/prepare-assets.mjs && next dev -p 3001",
    "build": "node scripts/prepare-assets.mjs && next build",
    "start": "next start -p 3001",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test --project=desktop --project=mobile",
    "screenshots": "E2E_SKIP_DEDUP=1 playwright test --project=screens"
  },
  "dependencies": {
    "@afisha/contract": "workspace:*",
    "@afisha/design-tokens": "workspace:*",
    "@afisha/i18n": "workspace:*",
    "next": "16.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
