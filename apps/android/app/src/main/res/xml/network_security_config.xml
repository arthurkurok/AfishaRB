<?xml version="1.0" encoding="utf-8"?>
<!-- Релиз: только HTTPS. Корень НУЦ Минцифры добавляется сюда, когда владелец передаст сертификат (docs/09 §4). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
