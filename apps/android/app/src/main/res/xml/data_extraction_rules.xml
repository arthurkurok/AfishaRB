<?xml version="1.0" encoding="utf-8"?>
<!-- Резервная копия: настройки и избранное; кэш афиши не копируем — он восстанавливается из сети. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="afisha.db" />
        <include domain="file" path="datastore/settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="afisha.db" />
        <include domain="file" path="datastore/settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
