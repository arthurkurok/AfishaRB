# Скопируйте в .env и заполните. .env не коммитится.
AFISHA_ENV=dev
AFISHA_DATABASE_URL=postgres://afisha:afisha@localhost:55432/afisha
AFISHA_PUBLIC_BASE_URL=http://localhost:3000
AFISHA_API_BASE_URL=http://localhost:8000
AFISHA_ADMIN_TOKEN=замените-на-длинный-случайный-токен

# Пароль PostgreSQL для docker compose (db/seed/api). В dev-стеке по умолчанию afisha;
# в production (docker-compose.prod.yml) обязателен и должен быть длинным и случайным.
PG_PASSWORD=afisha

# GigaChat — API Сбера: ключ авторизации (Basic) из личного кабинета developers.sber.ru
AFISHA_GIGACHAT_CREDENTIALS=
AFISHA_GIGACHAT_SCOPE=GIGACHAT_API_PERS
AFISHA_GIGACHAT_CA_FILE=infra/certs/russian_trusted_root_ca.pem
# GigaChat — cloud.ru Evolution Foundation Models (OpenAI-совместимый API)
AFISHA_CLOUDRU_API_KEY=

# Лимиты и тарифы ИИ-гида (расчёт стоимости диалога: токены × цена, ₽ за 1 млн токенов)
# Цена быстрой модели (GigaChat-2 — разбор запроса, guard): ₽/1M токенов
AFISHA_AI_PRICE_FAST_RUB_PER_1M=200
# Цена умной модели (GigaChat-2-Pro — подбор и объяснения): ₽/1M токенов
AFISHA_AI_PRICE_SMART_RUB_PER_1M=1200
# Потолок стоимости одного диалога с ИИ-гидом, ₽ (дальше — ответ детерминированным конвейером)
AFISHA_AI_DIALOG_COST_LIMIT_RUB=5
# Дневной потолок на пользователя, ₽ (дальше до конца суток — режим правил)
AFISHA_AI_USER_DAILY_COST_RUB=50
# Максимум шагов конвейера ИИ-гидa (вызовов инструментов) на один запрос
AFISHA_AGENT_MAX_STEPS=5

# Telegram: токен от @BotFather и исходящий прокси за рубежом (Telegram в РФ заблокирован)
AFISHA_TELEGRAM_BOT_TOKEN=
AFISHA_TELEGRAM_PROXY=
AFISHA_TELEGRAM_WEBAPP_URL=

# Сайт (apps/web, порт 3000). NEXT_PUBLIC_API_BASE вшивается в клиентский бандл при сборке образа
# (docker compose build arg) — это адрес, по которому браузер пользователя ходит в API.
NEXT_PUBLIC_API_BASE=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Рабочее место сотрудников (apps/admin, порт 3001). Токен Admin API вводится на /login и хранится только на сервере.
ADMIN_API_BASE=http://localhost:8000
# Секрет шифрования cookie сессии (не короче 32 символов; в production обязателен).
# В dev-стеке docker compose подставлено фиксированное значение — при выводе в прод замените!
ADMIN_SESSION_SECRET=
# false только для http-демо на localhost; в production (https) не задавайте — cookie будет Secure
ADMIN_COOKIE_SECURE=false
# Секрет HMAC для обезличивания идентификаторов в журналах (в prod обязателен, ≥ 32 символов)
AFISHA_SECRET=
