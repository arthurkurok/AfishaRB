{
  "$description": "Дизайн-токены «Афиша РБ» (docs/07-design.md, ADR-015: редизайн 2026-11). Формат W3C DTCG. Контраст пар текст/фон проверен по WCAG 2.2 AA.",
  "color": {
    "bg": {
      "$type": "color",
      "$value": "#F7F6F3",
      "$extensions": { "dark": "#131110" },
      "$description": "Холст страницы"
    },
    "surface": { "$type": "color", "$value": "#FFFFFF", "$extensions": { "dark": "#1C1A18" } },
    "surface-2": { "$type": "color", "$value": "#EFEEEA", "$extensions": { "dark": "#272422" } },
    "ink": { "$type": "color", "$value": "#171512", "$extensions": { "dark": "#F5F3F0" } },
    "ink-2": { "$type": "color", "$value": "#6B6660", "$extensions": { "dark": "#A9A29A" } },
    "line": { "$type": "color", "$value": "#E5E3DE", "$extensions": { "dark": "#34302C" } },
    "accent": {
      "$type": "color",
      "$value": "#C33124",
      "$extensions": { "dark": "#F4796A" },
      "$description": "Коралл — основное действие"
    },
    "on-accent": { "$type": "color", "$value": "#FFFFFF", "$extensions": { "dark": "#1A0F0D" } },
    "honey": {
      "$type": "color",
      "$value": "#F0B32E",
      "$extensions": { "dark": "#F0B32E" },
      "$description": "Шафран — только фон под тёмным текстом"
    },
    "meadow": { "$type": "color", "$value": "#237A48", "$extensions": { "dark": "#7BCB96" } },
    "focus": { "$type": "color", "$value": "#2E64A8", "$extensions": { "dark": "#7FA9E8" } },
    "category": {
      "theatre": { "$type": "color", "$value": "#B8322A" },
      "music": { "$type": "color", "$value": "#2E64A8" },
      "museum": { "$type": "color", "$value": "#8F6209" },
      "kids": { "$type": "color", "$value": "#A84A14" },
      "folk": { "$type": "color", "$value": "#2F7A4B" },
      "cinema": { "$type": "color", "$value": "#6B3A6E" },
      "education": { "$type": "color", "$value": "#1F6B70" }
    },
    "status": {
      "rescheduled": { "$type": "color", "$value": "#2E64A8", "$extensions": { "dark": "#7FA9E8" } },
      "cancelled": { "$type": "color", "$value": "#B8322A", "$extensions": { "dark": "#F07A68" } },
      "ended": { "$type": "color", "$value": "#6B6660", "$extensions": { "dark": "#A9A29A" } },
      "few-left": { "$type": "color", "$value": "#F0B32E" },
      "unverified": { "$type": "color", "$value": "#8F6209", "$extensions": { "dark": "#E8A92E" } }
    }
  },
  "font": {
    "display": { "$type": "fontFamily", "$value": ["Golos Text", "system-ui", "sans-serif"] },
    "text": { "$type": "fontFamily", "$value": ["Golos Text", "system-ui", "sans-serif"] }
  },
  "type": {
    "display": { "size": 56, "line": 60, "weight": 800, "family": "display" },
    "h1": { "size": 34, "line": 40, "weight": 800, "family": "display" },
    "h2": { "size": 24, "line": 30, "weight": 700, "family": "display" },
    "title": { "size": 17, "line": 24, "weight": 600, "family": "text" },
    "body": { "size": 16, "line": 24, "weight": 400, "family": "text" },
    "caption": { "size": 13, "line": 18, "weight": 500, "family": "text" },
    "date-big": { "size": 32, "line": 32, "weight": 800, "family": "display" }
  },
  "radius": { "s": 10, "m": 14, "l": 18, "pill": 999 },
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 24, "6": 32, "7": 48 },
  "motion": { "fast": 120, "base": 220, "slow": 360, "easing": "cubic-bezier(.2,.8,.2,1)" },
  "touch": { "min-ios": 44, "min-android": 48 }
}
