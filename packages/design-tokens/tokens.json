{
  "$description": "Дизайн-токены «Живой орнамент» (docs/07-design.md). Формат W3C DTCG. Контраст пар текст/фон проверен по WCAG 2.2 AA.",
  "color": {
    "bg": {
      "$type": "color",
      "$value": "#F6F0E4",
      "$extensions": { "dark": "#16120F" },
      "$description": "Холст / бархат"
    },
    "surface": { "$type": "color", "$value": "#FFFFFF", "$extensions": { "dark": "#231D18" } },
    "surface-2": { "$type": "color", "$value": "#EFE6D6", "$extensions": { "dark": "#2E2620" } },
    "ink": { "$type": "color", "$value": "#16120F", "$extensions": { "dark": "#F6F0E4" } },
    "ink-2": { "$type": "color", "$value": "#5C5047", "$extensions": { "dark": "#BFB3A5" } },
    "line": { "$type": "color", "$value": "#DDD2C0", "$extensions": { "dark": "#3A3029" } },
    "accent": {
      "$type": "color",
      "$value": "#B8322A",
      "$extensions": { "dark": "#F07A68" },
      "$description": "Коралл — основное действие"
    },
    "on-accent": { "$type": "color", "$value": "#FFFFFF", "$extensions": { "dark": "#16120F" } },
    "honey": {
      "$type": "color",
      "$value": "#E8A92E",
      "$extensions": { "dark": "#E8A92E" },
      "$description": "Шафран — только фон под тёмным текстом"
    },
    "meadow": { "$type": "color", "$value": "#2F7A4B", "$extensions": { "dark": "#6CC08A" } },
    "focus": { "$type": "color", "$value": "#2E64A8", "$extensions": { "dark": "#7FA9E8" } },
    "category": {
      "theatre": { "$type": "color", "$value": "#B8322A" },
      "music": { "$type": "color", "$value": "#2E64A8" },
      "museum": { "$type": "color", "$value": "#8F6209" },
      "kids": { "$type": "color", "$value": "#A84A14" },
      "folk": { "$type": "color", "$value": "#2F7A4B" },
      "cinema": { "$type": "color", "$value": "#6B3A6E" },
      "education": { "$type": "color", "$value": "#1F6B70" }
    },
    "status": {
      "rescheduled": { "$type": "color", "$value": "#2E64A8", "$extensions": { "dark": "#7FA9E8" } },
      "cancelled": { "$type": "color", "$value": "#B8322A", "$extensions": { "dark": "#F07A68" } },
      "ended": { "$type": "color", "$value": "#5C5047", "$extensions": { "dark": "#BFB3A5" } },
      "few-left": { "$type": "color", "$value": "#E8A92E" },
      "unverified": { "$type": "color", "$value": "#8F6209", "$extensions": { "dark": "#E8A92E" } }
    }
  },
  "font": {
    "display": { "$type": "fontFamily", "$value": ["Commissioner", "Golos Text", "system-ui", "sans-serif"] },
    "text": { "$type": "fontFamily", "$value": ["Golos Text", "system-ui", "sans-serif"] }
  },
  "type": {
    "display": { "size": 40, "line": 44, "weight": 700, "family": "display" },
    "h1": { "size": 28, "line": 32, "weight": 700, "family": "display" },
    "h2": { "size": 22, "line": 28, "weight": 600, "family": "display" },
    "title": { "size": 18, "line": 24, "weight": 600, "family": "text" },
    "body": { "size": 16, "line": 24, "weight": 400, "family": "text" },
    "caption": { "size": 13, "line": 18, "weight": 500, "family": "text" },
    "date-big": { "size": 32, "line": 32, "weight": 800, "family": "display" }
  },
  "radius": { "s": 8, "m": 14, "l": 22, "pill": 999 },
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 24, "6": 32, "7": 48 },
  "motion": { "fast": 120, "base": 220, "slow": 360, "easing": "cubic-bezier(.2,.8,.2,1)" },
  "touch": { "min-ios": 44, "min-android": 48 }
}
